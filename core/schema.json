{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RespostaInfraMind",
  "type": "object",
  "additionalProperties": false,
  "required": ["cobertura", "severidade", "diagnostico", "passos", "fontes", "escalar"],
  "properties": {
    "cobertura": {"enum": ["coberto", "fora_da_base", "recusado"]},
    "severidade": {"enum": ["baixa", "media", "alta", "critica", null]},
    "analise": {"type": "string", "description": "v3: sintoma, hipóteses e documento escolhido, escrito antes dos passos"},
    "diagnostico": {"type": "string"},
    "passos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acao", "fonte"],
        "properties": {
          "acao": {"type": "string", "minLength": 1},
          "fonte": {"type": "string", "pattern": "^(INC-\\d{3}|KB-\\d{4}|DOC-[A-Z]+|APX-[A-C])$"}
        }
      }
    },
    "fontes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(INC-\\d{3}|KB-\\d{4}|DOC-[A-Z]+|APX-[A-C])$"}
    },
    "escalar": {"type": "boolean"},
    "aviso": {"type": "string", "description": "Contradição entre documentos, documento suspeito ou outro alerta para quem está de plantão"}
  }
}
